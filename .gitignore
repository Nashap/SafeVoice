# Root .gitignore for SafeVoice Repository

# Operating System & IDEs
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Environment & Secrets (Never commit secrets!)
.env
.env.*
!.env.example
*.env
*serviceAccount*.json
secrets/

# Python / Django
__pycache__/
*.py[cod]
*$py.class
*.sqlite3
db.sqlite3
media/
staticfiles/
*.log

# Python Virtual Environments
venv/
env/
ENV/
.venv/

# Audio Recordings & Emergency Media
emergency-audio/
*.wav

# Test Screenshots & Transient Logs
*.png
adb_logs*.txt
log.txt

# Node & React Native
node_modules/
npm-debug.log
yarn-error.log
/coverage
.metro-health-check*
*.jsbundle

# Android Build Outputs
android/app/build/
android/.gradle/
android/local.properties
android/*.iml
android/.cxx/
android/.kotlin/

# iOS Build Outputs
ios/build/
ios/Pods/
ios/DerivedData/
