# ==============================================================================
# SafeVoice Backend — Environment Variables Template
# ==============================================================================
# NOTE: Never commit .env with real production secrets to Git!
# Copy this file to .env for local development or configure these variables
# directly in the Render Dashboard under "Environment".
# ==============================================================================

# 1. Django Security Settings
# Generate a secure 50+ character secret key in production (Render can auto-generate)
SECRET_KEY=your-django-production-secret-key-placeholder
# Set DEBUG to False in production!
DEBUG=False
# Comma-separated list of allowed hostnames (e.g. your-app.onrender.com)
ALLOWED_HOSTS=*
# Comma-separated list of CSRF trusted origins
CSRF_TRUSTED_ORIGINS=https://your-service-name.onrender.com
# CORS: Set to True for mobile client API access
CORS_ALLOW_ALL_ORIGINS=True

# 2. Database Configuration (Supabase PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# 3. Supabase Storage Configuration (for Emergency Audio Evidence)
# SUPABASE_URL: Your Supabase project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: Service role secret key (never expose publicly)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-placeholder
SUPABASE_STORAGE_BUCKET=emergency-audio

# 4. Firebase Cloud Messaging (FCM) Credentials
# Option A (Recommended for Render): Raw JSON string of your Firebase serviceAccountKey.json
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"safevoice-placeholder",...}
# Option B (Render Secret File): Path to uploaded secret file
# FIREBASE_CREDENTIALS_PATH=/etc/secrets/serviceAccountKey.json
# Option C (Local Windows Development):
# FIREBASE_CREDENTIALS_PATH=C:\SafeVoiceSecrets\serviceAccountKey.json