# Django configuration
SECRET_KEY=your-secret-key-placeholder
DEBUG=True
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
SMS_PROVIDER=dummy
# JWT configuration
JWT_SIGNING_KEY=your-jwt-signing-key-placeholder

# SMS Provider Configuration
# Choose from: 'dummy', 'msg91', 'twilio'

SMS_API_KEY=your_api_key_here
SMS_SENDER_ID=SVOICE
# Required for MSG91 (DLT Compliant Template ID)
SMS_TEMPLATE_ID=your_dlt_template_id
# Required for Twilio (Account SID)
SMS_BASE_URL=your_account_sid

# Firebase Configuration
FIREBASE_CREDENTIALS_PATH=C:\SafeVoiceSecrets\serviceAccountKey.json

# Supabase Storage Configuration (for emergency audio clips)
# SUPABASE_URL: Your Supabase project URL (e.g. https://<project-ref>.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: Supabase service_role key (server-side only, used to upload to private bucket)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_STORAGE_BUCKET=emergency-audio